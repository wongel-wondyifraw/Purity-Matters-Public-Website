# ----------------------------------------------------------------------
# Purity Matters Public Website - cPanel / LiteSpeed Apache Configuration
# ----------------------------------------------------------------------

RewriteEngine On
RewriteBase /

# Ensure proper MIME types for fonts, styles, and scripts
<IfModule mod_mime.c>
  AddType text/css .css
  AddType text/javascript .js
  AddType application/javascript .js
  AddType font/woff2 .woff2
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# Enable Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json font/woff2
</IfModule>

# Caching for immutable static assets (_next/static)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Prevent directory listing
Options -Indexes

# If the requested file or folder exists in public/ (e.g. _next/static, favicon, images), serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# For clean URLs without .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
